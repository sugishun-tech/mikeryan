{
  "name": "mikeryan",
  "version": "1.3.2",
  "private": true,
  "type": "module",
  "description": "A single-site, low-traffic Nostr client for GitHub Pages",
  "license": "MIT",
  "scripts": {
    "test": "node --test tests/*.test.js",
    "check": "node scripts/check.mjs",
    "serve": "python3 -m http.server 8080",
    "build": "node scripts/build.mjs",
    "benchmark": "node scripts/benchmark-persistence.mjs",
    "test:browser": "python3 tests/browser_persistence.py",
    "test:browser:completeness": "python3 tests/browser_completeness.py",
    "test:browser:relationships": "python3 tests/browser_relationships.py",
    "test:browser:audit": "python3 tests/browser_audit.py",
    "test:transport": "python3 tests/transport_integration.py",
    "test:browser:content": "python3 tests/browser_content.py"
  },
  "engines": {
    "node": ">=20"
  }
}
